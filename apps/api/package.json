{
  "name": "@uigen/api",
  "version": "0.1.0",
  "private": true,
  "description": "UIGen backend API — Express + MongoDB",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsup src/server.ts --format cjs --out-dir dist",
    "dev": "tsx watch src/server.ts",
    "seed": "tsx src/seed.ts",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongoose": "^8.9.2",
    "zod": "^3.24.1",
    "argon2": "^0.41.1",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.4.1",
    "morgan": "^1.10.0",
    "dotenv": "^16.4.7",
    "cookie-parser": "^1.4.7"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/cookie-parser": "^1.4.8",
    "@types/node": "^22.10.2"
  }
}
