{
  "name": "uigen-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "UIGen — CLI-first UI generation platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @uigen/api dev",
    "dev:web": "pnpm --filter @uigen/web dev",
    "seed": "pnpm --filter @uigen/api seed",
    "uigen": "node packages/cli/dist/index.js",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
