{
  "name": "@uigen/utils",
  "version": "0.1.0",
  "private": true,
  "description": "Shared utilities for UIGen packages",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint --no-error-on-unmatched-pattern src/",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "ora": "^8.1.1",
    "fs-extra": "^11.2.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "@types/fs-extra": "^11.0.4",
    "typescript": "^5.7.2"
  }
}
