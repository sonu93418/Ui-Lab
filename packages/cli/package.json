{
  "name": "uigen",
  "version": "0.1.0",
  "description": "UIGen CLI — Choose. Generate. Own. Ship.",
  "keywords": ["ui", "cli", "components", "react", "nextjs", "tailwind", "generator"],
  "homepage": "https://uigen.dev",
  "repository": "https://github.com/yourusername/uigen",
  "license": "MIT",
  "author": "UIGen",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "uigen": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "clean": "rm -rf dist",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "@inquirer/prompts": "^7.2.0",
    "chalk": "^5.4.1",
    "ora": "^8.1.1",
    "execa": "^9.5.2",
    "fs-extra": "^11.2.0",
    "open": "^10.1.0",
    "@uigen/utils": "workspace:*",
    "@uigen/config": "workspace:*",
    "@uigen/registry": "workspace:*",
    "@uigen/generator": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.10.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
